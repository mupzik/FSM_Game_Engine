<UserControl x:Class="GameProj.GameCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <!-- Игровая область -->
        <Canvas x:Name="GameArea" Width="960" Height="960"/>

        <!-- UI Overlay -->
        <StackPanel Margin="10">
            <TextBlock x:Name="GameStateDisplay" Foreground="White" FontSize="14"/>
            <TextBlock x:Name="PlayerInventory" Foreground="White" FontSize="12"/>
            <TextBlock x:Name="AllyInventory" Foreground="White" FontSize="12"/>
        </StackPanel>

        <!-- Подсказка обучения -->
        <Border x:Name="TutorialHint" Background="#80000000" Padding="10" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20">
            <TextBlock Text="WASD — движение, E — взаимодействие, ESC — меню" 
                       Foreground="White" FontSize="14"/>
        </Border>

        <!-- Окно диалога -->
        <Border x:Name="DialogueBox" Background="#CC000000" Padding="15" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,80"
                Visibility="Collapsed" CornerRadius="5">
            <TextBlock x:Name="DialogueText" Foreground="White" FontSize="16" 
                       MaxWidth="400" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
<UserControl x:Class="GameProj.GameCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameProj"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Focusable="True"
             Background="Black">

    <UserControl.Resources>
        <!-- Кисть для левой панели инвентаря -->
        <ImageBrush x:Key="LeftPanelBrush" 
                    ImageSource="/Setting_menu.png"
                    Viewbox="0.5,0,0.5,1"
                    ViewboxUnits="RelativeToBoundingBox"
                    Stretch="Fill"/>

        <!-- Кисть для правой панели инвентаря -->
        <ImageBrush x:Key="RightPanelBrush" 
                    ImageSource="/Dialog_box.png"
                    Stretch="Fill"
                    AlignmentX="Center"
                    AlignmentY="Center"/>
    </UserControl.Resources>

    <Grid>
        <!-- Основная игровая область -->
        <Grid x:Name="GameContainer" ClipToBounds="True">
            <Canvas x:Name="GameArea" Background="Black" 
                    Width="{Binding ActualWidth, ElementName=GameContainer}"
                    Height="{Binding ActualHeight, ElementName=GameContainer}"/>
        </Grid>

        <!-- Оверлей для UI элементов -->
        <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False"/>

        <!-- Диалоговое окно -->
        <Border x:Name="DialogueBox" 
                Width="840" 
                Height="168" 
                Padding="40,15,40,15"
                CornerRadius="5"
                Canvas.ZIndex="200"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,50"
                Visibility="Collapsed">
            <Border.Background>
                <ImageBrush ImageSource="/Dialog_box.png" Stretch="Fill"/>
            </Border.Background>
            <TextBlock x:Name="DialogueText" 
                       FontSize="22" 
                       Foreground="Black" 
                       TextWrapping="Wrap" 
                       FontWeight="Bold" 
                       TextAlignment="Left" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Left"
                       MaxWidth="530"/>
        </Border>

        <!-- Окно проигрыша/победы -->
        <Border x:Name="GameOverBox" 
                Width="500"
                Height="250"
                CornerRadius="15"
                Canvas.ZIndex="1000"
                Visibility="Collapsed"
                Background="#CC000000"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <TextBlock x:Name="GameOverText" 
                       FontSize="40" 
                       FontWeight="Bold" 
                       Foreground="White"
                       TextAlignment="Center" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Инвентарь (скрыт по умолчанию) -->
        <Border x:Name="InventoryPanel" 
                Width="800" 
                Height="600"
                Canvas.ZIndex="300"
                Background="Transparent"
                Visibility="Collapsed"
                Focusable="True"
                FocusVisualStyle="{x:Null}">
            <Grid>
                <!-- Левая панель с фоном - список предметов -->
                <Border CornerRadius="15" 
                        Background="{StaticResource LeftPanelBrush}"
                        Margin="20,20,300,20"
                        Focusable="False">
                    <StackPanel>
                        <ListBox x:Name="InventoryItemsControl" 
Background="Transparent" 
BorderThickness="0"
Focusable="False" Margin="60,70,60,40" FontFamily="GOST type B" FontSize="15" Height="341">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="28"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Margin" Value="10,8"/>
                                    <Setter Property="Focusable" Value="False"/>

                                    <!-- Убираем рамку фокуса -->
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                    <!-- Полностью переопределяем шаблон, чтобы убрать визуальные эффекты -->
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter 
                   Content="{TemplateBinding Content}"
                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="DarkRed"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontSize" Value="32"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="StatusBar" Height="46" Width="372" FontFamily="GOST type B" FontWeight="Bold"  Text="ОЗ: 100/100 СИЛА: 15" TextAlignment="Center" FontSize="30"/>
                    </StackPanel>

                </Border>

                <!-- Правая панель описания предмета -->
                <Border Width="356" 
                        Height="188"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Bottom"
                        Margin="0,0,10,340"
                        Background="{StaticResource RightPanelBrush}"
                        CornerRadius="10"
                        Focusable="False">
                    <TextBlock x:Name="InventoryDescriptionText"
                               Foreground="#3E2723" 
                               FontSize="24" 
                               FontWeight="Bold"
                               TextWrapping="Wrap" 
                               Margin="15,15,15,15"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Text="Нет предметов"
                               Focusable="False" FontFamily="GOST type B"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
<Window x:Class="GameProj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameProj"
        mc:Ignorable="d"
        Title="Игра" Height="999" Width="975" Icon="/Potion.png">
    <Grid>
        <StackPanel x:Name="MainMenu" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,146,0,0" >
            <Button x:Name="BtnStart" Content="Новая игра"  Click="BtnStart_Click" Width="200" Height="50"/>
            <Button x:Name="BtnContinue" Content="Продолжить"  Click="BtnContinue_Click" Width="200" Height="50" IsEnabled="False" Margin="30"/>
            <Button x:Name="BtnExit" Content="Выход" Click="BtnExit_Click" Width="200" Height="50"/>
        </StackPanel>

        <local:GameCanvas x:Name="GameCanvas" Visibility="Collapsed" />
    </Grid>


</Window>
